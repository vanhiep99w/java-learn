  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "predev": "npm run sources:build",
    "prebuild": "npm run sources:build",
    "sources:build": "node scripts/build-source-examples.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "node --test tests/*.test.mjs",
