{
  "name": "java-learn",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "predev": "npm run sources:build",
    "prebuild": "npm run sources:build",
    "sources:build": "node scripts/build-source-examples.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "docs:inventory": "node scripts/diagram-inventory.mjs",
    "typecheck": "tsc --noEmit",
    "docs:audit": "node scripts/audit-diagrams.mjs",
    "docs:compare-layouts": "node scripts/compare-d2-layouts.mjs",
    "docs:check-export": "node scripts/check-diagram-export.mjs"
  },
  "dependencies": {
    "@vanhiep99w/docs-kit": "0.12.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-github-admonitions-to-directives": "^2.1.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "remark-frontmatter": "^5.0.0",
    "shiki": "^4.5.0",
    "typescript": "^5.7.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
